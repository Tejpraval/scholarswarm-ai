# ScholarSwarm AI — Environment Variables
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# ── LLM Provider (Required for live mode) ──────────────────────────────────────
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Web Search Provider (Required for live mode) ───────────────────────────────
# Get your Tavily API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite database file path (relative to backend/)
DB_PATH=scholarswarm.db

# ── File Uploads ───────────────────────────────────────────────────────────────
# Directory for uploaded PDF files (relative to backend/)
UPLOAD_DIR=uploads

# ── Application ────────────────────────────────────────────────────────────────
# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
